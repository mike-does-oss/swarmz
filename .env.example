# ---- LLM ----
ANTHROPIC_API_KEY=

# ---- swarmz ----
SWARMZ_DB_PATH=data/swarmz.duckdb
SWARMZ_AGENT_MODEL=claude-haiku-5-5       # the panel's discussion posts
SWARMZ_ELICIT_MODEL=claude-haiku-5-5      # the forecasts made alone and the final forecasts
SWARMZ_MUTATE_MODEL=claude-sonnet-5-5     # rewriting a persona when the panel evolves
SWARMZ_LESSON_MODEL=claude-haiku-5-5      # post-mortems after a question resolves
SWARMZ_POPULATION_SIZE=10                 # members on the panel
SWARMZ_DISCUSSION_ROUNDS=5                # rounds of discussion after the opening forecasts; cost grows faster than the rounds
SWARMZ_CHALLENGERS=2                      # members per question told to argue against the leading view

# ---- resolution ----
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
