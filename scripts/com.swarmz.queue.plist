<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts scripts/run_queue.py at the top of every hour; the script itself acts on even UTC hours only.
     Install: make queue-on    Remove: make queue-off    Log: logs/queue.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.swarmz.queue</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mike/Desktop/projects/swarmz/.venv/bin/python</string>
    <string>/Users/mike/Desktop/projects/swarmz/scripts/run_queue.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/mike/Desktop/projects/swarmz</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/mike/Desktop/projects/swarmz/logs/queue.log</string>
  <key>StandardErrorPath</key><string>/Users/mike/Desktop/projects/swarmz/logs/queue.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
