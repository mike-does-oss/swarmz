{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "cloud_public",
  "regions": ["iad1"],
  "functions": {
    "api/tick.py": {
      "maxDuration": 800,
      "excludeFiles": "{web/**,tests/**,briefbuilder/tests/**,docs/**,data/**,backups/**,reports/**,logs/**,.venv/**,.superpowers/**,**/__pycache__/**}"
    }
  },
  "crons": [{ "path": "/api/tick", "schedule": "0 */2 * * *" }]
}
